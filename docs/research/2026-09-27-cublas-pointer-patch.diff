+    /// The backend's own raw device addresses for `handles`, and the raw
+    /// stream they are used on. See [`Server::native_ptrs`] and
+    /// [`Server::native_stream`]: this is the pair a foreign device library
+    /// (cuBLAS, cuDNN) needs to run on this graph's stream, over this
+    /// allocator's memory, without a host round trip.
+    ///
+    /// `None` inside the vector is a binding the backend cannot address, and a
+    /// `None` stream is a backend with no stream to borrow. One round trip for
+    /// the whole batch, and the stream is a per-stream constant, so a caller
+    /// resolves that once and reuses it.
+    ///
+    /// # Errors
+    ///
+    /// [`ServerError::ServiceMismatch`] when `S` is not this client's server.
+    pub fn native_handles<S: Server>(
+        &self,
+        handles: Vec<Handle>,
+    ) -> Result<(Vec<Option<u64>>, Option<u64>), ServerError> {
+        let stream_id = self.stream_id();
+        let bindings = handles
+            .into_iter()
+            .map(|handle| handle.binding())
+            .collect::<Vec<_>>();
+        for binding in &bindings {
+            self.local(binding)?;
+        }
+        if !self.is_service::<S>() {
+            return Err(ServerError::ServiceMismatch {
+                client: format!("{}", self.service_id()),
+                requested: String::from(core::any::type_name::<S>()),
+                backtrace: BackTrace::capture(),
+            });
+        }
+        Ok(self
+            .device
+            .submit_blocking(move |server| {
+                let server = (server as &mut dyn Any)
+                    .downcast_mut::<S>()
+                    .expect("is_service passed, so this is the server's type");
+                let ptrs: Vec<Option<u64>> = server
+                    .native_ptrs(bindings, stream_id)
+                    .map(|ptrs| ptrs.into_iter().map(Some).collect())
+                    .unwrap_or_default();
+                (ptrs, server.native_stream(stream_id))
+            })
+            .map_err(Into::into)
+            .unwrap_or_resume())
+    }
