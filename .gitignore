*.bin
.bulba//target/
/checkpoints/
checkpoints/
/runs/
target/
__pycache__/

# Tool output, not source. `.playwright-mcp/` is the browser-MCP session log
# (console-*.log, page-*.yml) and `graphify-out/` is the knowledge graph the
# graphify skill writes. Both were tracked once: a tracked file is unaffected by
# .gitignore, so the rule below only bites after `git rm --cached`.
.playwright-mcp/
graphify-out/

# Local data + tooling state (never source).
data_local/
.cortexkit/
wt/
vendor/cubecl-cuda/
vendor/cubecl-runtime/
vendor/cubecl-server/

# Python environment and run artifacts (merged from port/.gitignore, 2026-10-19).
.venv/
.pytest_cache/
.ruff_cache/
sft_pairs/aria_*.jsonl

# Node (docs-site) and build artifacts.
node_modules/
.astro/

# The demo's model artifact is GENERATED (16.3 MB, over the 8 MB commit rule):
# `dormouse export small --ckpt-name … --engram-dtype fp16 --out
# docs-site/public/demo/model.dormouse`. See docs-site/public/demo/README.md.
docs-site/public/demo/model.dormouse
docs-site/dist/
