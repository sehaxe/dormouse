---
// The dormouse front page, rendered for one language. A hand-written document,
// NOT a Starlight/MDX page: it is a manpage-shaped page in opencode.ai's design
// language (tokens in src/styles/landing.css), while every Starlight route
// under /start-here/, /architecture/, /archive/ … stays generated by
// tools/ingest.mjs from the canonical files.
//
// Two static pages share this component (src/pages/index.astro = en,
// src/pages/ru.astro = ru): the language switch is a real link, so it works
// without JavaScript and both languages are indexable. The theme follows the
// reader's system preference in pure CSS. The one inline script only
// re-animates what is already in the DOM (typing + count-up) and does nothing
// under prefers-reduced-motion.
import '../styles/landing.css';

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const at = (path) => `${base}${path}`;
const other = lang === 'en' ? at('/ru/') : at('/');

// The social card: one image for the whole site. Absolute URLs, because a
// crawler does not resolve a relative og:image (the same requirement that made
// astro.config.mjs carry the Pages origin instead of the GitHub URL).
const siteUrl = 'https://sehaxe.github.io/dormouse';
const ogImage = `${siteUrl}/og.png`;

const COPY = {
	en: {
		title: 'dormouse — a byte-level MoE language model on one consumer GPU',
		description:
			'A byte-level Mixture-of-Experts language model, trained end to end on one consumer GPU: 1.07B total / 57M active parameters, 40.9k tok/s and BPB 1.936 held-out on one RTX 5060 Ti.',
		nav: { docs: 'docs', status: 'status', github: 'github', demo: 'demo', lang: 'ru', langTitle: 'Русская версия' },
		termBar: { left: 'dormouse(1)', right: 'rtx 5060 ti · 16 gb' },
		termHints: ['[+] 882 tests', '[+] ruff clean', '[-] cuda gates self-skip'],
		session: `$ dormouse train medium --set seq_len=1024 --set moe_capacity=0
step=60000  loss=1.2130  bpb=1.936  40.9k tok/s
$ dormouse serve --ckpt-name sft11 --port 3783
ready — one RTX 5060 Ti 16GB, $429`,
		tagline:
			'A byte-level Mixture-of-Experts language model, trained end to end on one consumer GPU.',
		band: [
			{ n: '1.07B', cap: 'total params · 57M\u00a0active' },
			{ n: '40.9k', cap: 'tok/s, medium b24\u00a0×\u00a0s1024' },
			{ n: '1.936', cap: 'held-out BPB, 196,608\u00a0B window' },
			{ n: '882', cap: 'tests, ruff clean' },
			{ n: '$429', cap: 'one RTX 5060\u00a0Ti 16\u00a0GB' },
		],
		whyTitle: 'Why this exists',
		why: [
			'The frontier publishes its recipes and not its compute. This project asks the narrower question: take the same ideas — linear attention, sparse experts, memory outside the weights, low-rank factors, bytes instead of tokens — and point them at one $429 GPU. How far do they actually go?',
			'The framework is the instrument; the model is the reading. Every number on this page was taken on this box, at a named config and commit, and a mechanism that fails its A/B is recorded as a failure rather than deleted quietly.',
		],
		registerTitle: 'Admitted and rejected by measurement',
		register: [
			{ name: 'ColRow normalization', delta: '−0.043 BPB', admitted: true },
			{ name: 'NorMuon', delta: '+0.072' },
			{ name: 'schedule-free Muon', delta: '+0.043' },
			{ name: 'SIGReg', delta: '+0.148' },
		],
		axesTitle: 'The five axes',
		axes: [
			{
				name: 'byte-level',
				body: 'Vocabulary of 256 bytes. No BPE and no tokenizer tax on Russian, code, or anything the tokenizer never saw in training.',
			},
			{
				name: 'KDA linear attention',
				body: 'Kimi-style chunked gated delta rule. O(n) context and a fixed 256 KB recurrent state at any context length — there is no KV cache to blow up.',
			},
			{
				name: 'dropless MoE',
				body: '1024 experts, top-k 2, no capacity drops: every token keeps every expert it routed to.',
			},
			{
				name: 'TSCT low-rank experts',
				body: 'Every expert is U·diag(s)·Vᵀ at rank 64. That factorization is what lets a 1.07B-parameter model fit, train and ship on 16 GB.',
			},
			{
				name: 'Engram memory',
				body: '402M hash-table parameters that live in host RAM, outside the compute graph.',
			},
		],
		stackTitle: 'The stack, and why each piece is here',
		stack: [
			{ name: 'byte-level input', why: 'one vocabulary for every language, code and binary; no tokenizer to train, and speculative decoding accepts 3.4× more tokens than subword (2610.05978).' },
			{ name: 'KDA attention', why: 'linear in length with a fixed recurrent state, so a long context costs memory that does not grow — the reason 1M context is a configuration, not a rebuild.' },
			{ name: 'dropless MoE + LFB', why: 'capacity that does not drop tokens: load balancing by a bias on the router, not by an auxiliary loss that fights the language objective (2408.15664).' },
			{ name: 'TSCT low-rank experts', why: 'a 1.07B-parameter model in 16 GB: each expert is U·diag(s)·Vᵀ at rank 64, and the same factorization carries the fp8→NVFP4→ternary storage ladder.' },
			{ name: 'Engram memory', why: 'knowledge that costs no FLOPs: 402M hash rows in host RAM, of which one token touches ~0.02%.' },
			{ name: 'weight-shared loop', why: 'depth without parameters — three passes through one block, the measured optimum of 2/3/4 on our protocol.' },
			{ name: 'Muon + ColRow, WSD', why: 'the best of five optimizers A/B’d here; NorMuon, schedule-free Muon and SIGReg all lost to it and are recorded as losses.' },
			{ name: 'verifier-first post-training', why: 'code and math verifiers plus fork-replay advantages — post-training without a learned reward model, and a length penalty that rewards solving in fewer bytes.' },
