					  <rect x="222" y="0" width="12" height="6"/>
					  <rect x="216" y="6" width="6" height="6"/>
					  <rect x="234" y="6" width="6" height="6"/>
					  <rect x="216" y="12" width="24" height="6"/>
					  <rect x="216" y="18" width="6" height="6"/>
					  <rect x="222" y="24" width="18" height="6"/>
					</g>
					</svg>
					<pre class="term-body" data-term>{c.session}</pre>
					<div class="term-hints">
						{c.termHints.map((h) => (
							<span>{h}</span>
						))}
					</div>
				</div>
			</header>

			<section class="wrap band" aria-label={c.whyTitle}>
				{c.band.map((b, i) => (
					<div class="band-cell">
						{b.n === '$429' ? (
							<span class="band-n">
								$<span data-count data-to="429" data-dec="0">429</span>
							</span>
						) : (
							<span
								class="band-n"
								data-count
								data-to={b.n.replace(/[^\d.]/g, '')}
								data-dec={b.n.includes('.') ? String(b.n.split('.')[1].replace(/[^\d]/g, '').length) : '0'}
								data-suffix={b.n.replace(/^[\d.]+/, '')}
							>
								{b.n}
							</span>
						)}
						<span class="band-cap">{b.cap}</span>
					</div>
				))}
			</section>

			<section class="section wrap" data-reveal>
				<h2>{c.whyTitle}</h2>
				{c.why.map((p) => (
					<p class="prose">{p}</p>
				))}
				<h3 class="sub">{c.registerTitle}</h3>
				<ul class="register">
					{c.register.map((r) => (
						<li class={r.admitted ? 'admitted' : ''} data-reveal>
							<span class="name">{r.name}</span>
							<span class="delta">{r.delta}</span>
						</li>
					))}
				</ul>
				<p class="section-note">
					<a href={at('/start-here/status/')}>
						{lang === 'en' ? 'Status: the measured numbers, retractions included' : 'Статус: измеренные числа, включая отозванные'}
					</a>
				</p>
			</section>

			<section class="section wrap" data-reveal>
				<h2>{c.axesTitle}</h2>
				<div class="cards">
					{c.axes.map((a) => (
						<article class="card" data-reveal>
							<h3>{a.name}</h3>
							<p>{a.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="section wrap" data-reveal>
				<h2>{c.stackTitle}</h2>
				<dl class="tech">
					{c.stack.map((t) => (
						<div class="tech-row" data-reveal>
							<dt>{t.name}</dt>
							<dd>{t.why}</dd>
						</div>
					))}
				</dl>
			</section>

			<section class="section wrap" data-reveal>
				<h2>{c.docsTitle}</h2>
				<p class="prose">{c.docs}</p>
				<p class="section-note">
					<a href={at('/start-here/what-is-this/')}>{c.docsLinks[0]}</a> ·
					<a href={at('/archive/retracted/')}>{c.docsLinks[1]}</a> ·
					<a href={at('/architecture/glossary/')}>{c.docsLinks[2]}</a>
				</p>
			</section>

			<section class="section wrap" data-reveal>
				<h2>{c.peekTitle}</h2>
				<p class="prose">{c.peek}</p>
				<div class="peek">
					<div class="peek-nav" role="tablist" aria-label="Docs peek">
						{peekHrefs.map((href, i) => (
							<a
								href={at(href)}
								hx-get={at(href)}
								hx-select=".sl-markdown-content"
								hx-target="#peek-body"
								hx-swap="innerHTML"
								>[+] {c.peekTabs[i]}</a
							>
						))}
					</div>
					<div class="peek-body" id="peek-body">
						<p class="peek-hint">{c.peekHint}</p>
					</div>
				</div>
			</section>

			<section class="section wrap" data-reveal>
				<h2>{c.quickTitle}</h2>
				<pre class="snippet">{quickstart}</pre>
				<p class="section-note">
					{c.quickNote} <a href={at('/start-here/quick-start/')}>{c.quickLink}</a>.
				</p>
			</section>
		</main>

		<footer class="footer wrap">
			<span>{c.footer}</span>
			<span class="footer-links">
				<a href={at('/start-here/what-is-this/')}>{c.footerLinks.docs}</a>
				<a href={at('/start-here/status/')}>{c.footerLinks.status}</a>
				<a href={repo}>{c.footerLinks.github}</a>
				<a href={at('/start-here/license/')}>{c.footerLinks.license}</a>
			</span>
		</footer>

		<script is:inline>
			(() => {
				const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

				// ── the terminal: type the session, line by line, with a block cursor.
				// The final state is already in the DOM (it is what a reader without
				// JavaScript sees), so the height is measured first and held, and the
				// cursor is a stable node whose blink must not restart per character.
				const term = document.querySelector('[data-term]');
				if (term) {
					const full = term.textContent.replace(/\s+$/, '');
					const cursor = document.createElement('span');
					cursor.className = 'cursor';
					cursor.setAttribute('aria-hidden', 'true');
					term.style.minHeight = term.offsetHeight + 'px';

					const line = document.createTextNode(reduce ? full : '');
					term.textContent = '';
					term.append(line, cursor);

					if (!reduce) {
						const lines = full.split('\n');
						let out = '';
						let li = 0;
						let ci = 0;
						const step = () => {
							if (li === lines.length) return;
							const cur = lines[li];
							if (ci < cur.length) {
								out += cur[ci++];
								line.data = out;
								setTimeout(step, 12);
								return;
							}
							li += 1;
							ci = 0;
							// No newline after the last line: the typed state must be the
							// static state exactly, or the reserved height is 25px short.
							if (li === lines.length) return;
							out += '\n';
							line.data = out;
							setTimeout(step, 200);
						};
						setTimeout(step, 250);
					}
				}

				// ── what scrolls into view: add .is-in once, then stop watching.
				// The CSS owns what that means (a 6px rise and the section's rule
				// drawing itself); this only says when. Off under reduced motion.
				const reveals = document.querySelectorAll('[data-reveal]');
				if (reveals.length && !reduce) {
					const ro = new IntersectionObserver(
						(entries) => {
							for (const e of entries) {
								if (!e.isIntersecting) continue;
								ro.unobserve(e.target);
								e.target.classList.add('is-in');
							}
						},
						{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
					);
					reveals.forEach((r) => ro.observe(r));
				} else {
					reveals.forEach((r) => r.classList.add('is-in'));
				}

				// ── the stat band: count up once, on the way into view.
				const nums = document.querySelectorAll('[data-count]');
				if (nums.length && !reduce) {
					const run = (el) => {
						const to = Number(el.dataset.to);
						const dec = Number(el.dataset.dec);
						const suffix = el.dataset.suffix || '';
						const t0 = performance.now();
						const tick = (t) => {
							const p = Math.min(1, (t - t0) / 900);
							const eased = 1 - Math.pow(1 - p, 3);
							el.textContent = (to * eased).toFixed(dec) + suffix;
							if (p < 1) requestAnimationFrame(tick);
							else el.textContent = to.toFixed(dec) + suffix;
						};
						requestAnimationFrame(tick);
					};
					const io = new IntersectionObserver(
						(entries) => {
							for (const e of entries) {
								if (!e.isIntersecting) continue;
								io.unobserve(e.target);
								run(e.target);
							}
						},
						{ threshold: 0.5 },
					);
					nums.forEach((n) => io.observe(n));
				}
			})();
		</script>
	</body>
</html>
