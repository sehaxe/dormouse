		peekTabs: ['status', 'what this is', 'glossary'],
		quickTitle: 'Quick start',
		quickNote: 'Requires uv and Python 3.12 —',
		quickLink: 'the full list of commands',
		footer: '©2026 dormouse — every number carries its measurement.',
		footerLinks: { docs: 'Docs', status: 'Status', github: 'GitHub', license: 'MIT License' },
	},
	ru: {
		title: 'dormouse — байтовая MoE-модель на одной потребительской видеокарте',
