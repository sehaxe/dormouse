---
// The dormouse front page. A hand-written Astro page, NOT a Starlight/MDX page:
// the landing is a manpage-shaped document in opencode.ai's design language
// (see src/styles/landing.css for the tokens), while every Starlight route
// under /start-here/, /architecture/, /archive/ … stays generated by
// tools/ingest.mjs from the canonical files.
//
// It renders its final state statically: with JavaScript off, the terminal
// shows the whole session and every stat shows its measured value. The one
// inline script only re-animates what is already there (typing + count-up),
// and it does nothing at all under prefers-reduced-motion.
import '../styles/landing.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const at = (path) => `${base}${path}`;

// The run the terminal types out: the medium pretrain line and the serve line,
// with the numbers the README's Results table carries (40.9k tok/s, BPB 1.936).
const session = `$ dormouse train medium --set seq_len=1024 --set moe_capacity=0
step=60000  loss=1.2130  bpb=1.936  40.9k tok/s
$ dormouse serve --ckpt-name sft11 --port 3783
ready — one RTX 5060 Ti 16GB, $429`;

// The wordmark's only ornament: a block-pixel rodent, four rows of exactly
// nine cells so the outline cannot drift in any monospace face.
const mark = ` ▄▄   ▄▄ 
█▀▀▀▀▀▀▀█
█  ● ●  █
 ▀▀▀▀▀▀▀ `;

const quickstart = `uv sync                      # CPU environment; the tests run here
uv run pytest                # 861 tests, ruff clean
uv run dormouse train medium --data corpus.bin --eval held.bin --device cuda \\
  --steps 60000 --batch 24 --set seq_len=1024 --set moe_capacity=0
uv run dormouse serve --out-dir checkpoints/sft --ckpt-name sft11 --port 3783`;

const axes = [
	{
		name: 'byte-level',
		body: 'Vocabulary of 256 bytes. No BPE and no tokenizer tax on Russian, code, or anything the tokenizer never saw in training.',
	},
	{
		name: 'KDA linear attention',
		body: 'Kimi-style chunked gated delta rule. O(n) context and a fixed 256 KB recurrent state at any context length — there is no KV cache to blow up.',
	},
	{
		name: 'dropless MoE',
		body: '1024 experts, top-k 2, no capacity drops: every token keeps every expert it routed to.',
	},
	{
		name: 'TSCT low-rank experts',
		body: 'Every expert is U·diag(s)·Vᵀ at rank 64. That factorization is what lets a 1.07B-parameter model fit, train and ship on 16 GB.',
	},
	{
		name: 'Engram memory',
		body: '402M hash-table parameters that live in host RAM, outside the compute graph.',
	},
];

// The A/B register: one admitted mechanism, three rejected by measurement.
const register = [
	{ name: 'ColRow normalization', delta: '−0.043 BPB', admitted: true },
	{ name: 'NorMuon', delta: '+0.072' },
	{ name: 'schedule-free Muon', delta: '+0.043' },
	{ name: 'SIGReg', delta: '+0.148' },
];

const repo = 'https://github.com/sehaxe/dormouse';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>dormouse — a byte-level MoE language model on one consumer GPU</title>
		<meta
			name="description"
			content="A byte-level Mixture-of-Experts language model, trained end to end on one consumer GPU: 1.07B total / 57M active parameters, 40.9k tok/s and BPB 1.936 held-out on one RTX 5060 Ti."
		/>
		<link rel="icon" href={at('/favicon.svg')} type="image/svg+xml" />
		{/* htmx, vendored (docs-site/public/htmx.min.js, 2.0.4): the docs-peek
		    section loads Starlight pages in place. The page is complete without
		    it - the same links navigate normally. */}
		<script is:inline src={at('/htmx.min.js')} defer></script>
	</head>
	<body>
		<nav class="topbar">
			<div class="wrap topbar-in">
				<a class="topbar-mark" href={at('/')}>dormouse(1)</a>
				<span class="topbar-links">
					<a href={at('/start-here/what-is-this/')}>docs</a>
					<a href={at('/start-here/status/')}>status</a>
					<a href={repo}>github</a>
				</span>
			</div>
		</nav>

		<main>
			<header class="hero wrap">
				<p class="mark" aria-hidden="true">{mark}</p>
				<h1>dormouse</h1>
				<p class="tagline">
					A byte-level Mixture-of-Experts language model, trained end to end on one consumer GPU.
				</p>

				<div class="terminal">
					<div class="term-bar">
						<span>dormouse(1)</span>
						<span>rtx 5060 ti · 16 gb</span>
					</div>
					<pre class="term-body" data-term>{session}</pre>
					<div class="term-hints">
						<span>[+] 861 tests</span>
						<span>[+] ruff clean</span>
						<span>[-] cuda gates self-skip</span>
					</div>
				</div>
			</header>

			<section class="wrap band" aria-label="Measured numbers">
				<div class="band-cell">
					<span class="band-n" data-count data-to="1.07" data-dec="2" data-suffix="B">1.07B</span>
					<span class="band-cap">total params · 57M&nbsp;active</span>
				</div>
				<div class="band-cell">
					<span class="band-n" data-count data-to="40.9" data-dec="1" data-suffix="k">40.9k</span>
					<span class="band-cap">tok/s, medium b24&nbsp;×&nbsp;s1024</span>
				</div>
				<div class="band-cell">
					<span class="band-n" data-count data-to="1.936" data-dec="3">1.936</span>
					<span class="band-cap">held-out BPB, 196,608&nbsp;B window</span>
				</div>
				<div class="band-cell">
					<span class="band-n" data-count data-to="861" data-dec="0">861</span>
					<span class="band-cap">tests, ruff clean</span>
				</div>
				<div class="band-cell">
					<span class="band-n">$<span data-count data-to="429" data-dec="0">429</span></span>
					<span class="band-cap">one RTX 5060&nbsp;Ti 16&nbsp;GB</span>
				</div>
			</section>

			<section class="section wrap">
				<h2>The five axes</h2>
				<div class="cards">
					{axes.map((a) => (
						<article class="card">
							<h3>{a.name}</h3>
							<p>{a.body}</p>
						</article>
					))}
				</div>
			</section>

			<section class="section wrap">
				<h2>Measured, not claimed</h2>
				<p class="prose">
					Every mechanism in the tree was admitted by a 3-seed A/B on a fixed protocol — held-out
					bits-per-byte at a fixed step budget — and a tie deletes the mechanism. The losers are
					recorded, not deleted quietly, and the record is published next to the wins.
				</p>
				<ul class="register">
					{register.map((r) => (
						<li class={r.admitted ? 'admitted' : ''}>
							<span class="name">{r.name}</span>
							<span class="delta">{r.delta}</span>
						</li>
					))}
				</ul>
				<p class="section-note">
					<a href={at('/start-here/status/')}>Status: the measured numbers, retractions included</a>
				</p>
			</section>

			<section class="section wrap">
				<h2>A knowledge base with a retraction policy</h2>
				<p class="prose">
					Every page of the docs is generated at build time from the file that already lives in the
					repository — no second copy of any fact. A number is published with the config, the date and
					the commit it was taken at, and a claim that was taken back stays published next to the one
					that replaced it.
				</p>
				<p class="section-note">
					<a href={at('/start-here/what-is-this/')}>What this is</a> ·
					<a href={at('/archive/retracted/')}>Retracted, do not cite</a> ·
					<a href={at('/architecture/glossary/')}>The glossary</a>
				</p>
			</section>

			<section class="section wrap">
				<h2>Peek the docs without leaving</h2>
				<p class="prose">
					Three pages of the knowledge base, loaded in place by htmx from the same static build —
					no second copy of any fact, no reload. Without JavaScript the same links navigate
					normally.
				</p>
				<div class="peek">
					<div class="peek-nav" role="tablist" aria-label="Docs peek">
						<a
							href={at('/start-here/status/')}
							hx-get={at('/start-here/status/')}
							hx-select=".sl-markdown-content"
							hx-target="#peek-body"
							hx-swap="innerHTML"
							>[+] status</a
						>
						<a
							href={at('/start-here/what-is-this/')}
							hx-get={at('/start-here/what-is-this/')}
							hx-select=".sl-markdown-content"
							hx-target="#peek-body"
							hx-swap="innerHTML"
							>[+] what this is</a
						>
						<a
							href={at('/architecture/glossary/')}
							hx-get={at('/architecture/glossary/')}
							hx-select=".sl-markdown-content"
							hx-target="#peek-body"
							hx-swap="innerHTML"
							>[+] glossary</a
						>
					</div>
					<div class="peek-body" id="peek-body">
						<p class="peek-hint">
							Pick a page — it loads here from the same build. Full navigation still works:
							each is a real link.
						</p>
					</div>
				</div>
			</section>

			<section class="section wrap">
				<h2>Quick start</h2>
				<pre class="snippet">{quickstart}</pre>
				<p class="section-note">
					Requires uv and Python 3.12 — <a href={at('/start-here/quick-start/')}>the full list of commands</a>.
				</p>
			</section>
		</main>

		<footer class="footer wrap">
			<span>©2026 dormouse — every number carries its measurement.</span>
			<span class="footer-links">
				<a href={at('/start-here/what-is-this/')}>Docs</a>
				<a href={at('/start-here/status/')}>Status</a>
				<a href={repo}>GitHub</a>
				<a href={at('/start-here/license/')}>MIT License</a>
			</span>
		</footer>

		<script is:inline>
			(() => {
				const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

				// ── the terminal: type the session, line by line, with a block cursor.
				// The final state is already in the DOM (it is what a reader without
				// JavaScript sees), so the height is measured first and held, and the
				// cursor is a stable node whose blink must not restart per character.
				const term = document.querySelector('[data-term]');
				if (term) {
					const full = term.textContent.replace(/\s+$/, '');
					const cursor = document.createElement('span');
					cursor.className = 'cursor';
					cursor.setAttribute('aria-hidden', 'true');
					term.style.minHeight = term.offsetHeight + 'px';

					const line = document.createTextNode(reduce ? full : '');
					term.textContent = '';
					term.append(line, cursor);

					if (!reduce) {
						const lines = full.split('\n');
						let out = '';
						let li = 0;
						let ci = 0;
						const step = () => {
							if (li === lines.length) return;
							const cur = lines[li];
							if (ci < cur.length) {
								out += cur[ci++];
								line.data = out;
								setTimeout(step, 12);
								return;
							}
							li += 1;
							ci = 0;
							// No newline after the last line: the typed state must be the
							// static state exactly, or the reserved height is 25px short.
							if (li === lines.length) return;
							out += '\n';
							line.data = out;
							setTimeout(step, 200);
						};
						setTimeout(step, 250);
					}
				}

				// ── the stat band: count up once, on the way into view.
				const nums = document.querySelectorAll('[data-count]');
				if (nums.length && !reduce) {
					const run = (el) => {
						const to = Number(el.dataset.to);
						const dec = Number(el.dataset.dec);
						const suffix = el.dataset.suffix || '';
						const t0 = performance.now();
						const tick = (t) => {
							const p = Math.min(1, (t - t0) / 900);
							const eased = 1 - Math.pow(1 - p, 3);
							el.textContent = (to * eased).toFixed(dec) + suffix;
							if (p < 1) requestAnimationFrame(tick);
							else el.textContent = to.toFixed(dec) + suffix;
						};
						requestAnimationFrame(tick);
					};
					const io = new IntersectionObserver(
						(entries) => {
							for (const e of entries) {
								if (!e.isIntersecting) continue;
								io.unobserve(e.target);
								run(e.target);
							}
						},
						{ threshold: 0.5 },
					);
					nums.forEach((n) => io.observe(n));
				}
			})();
		</script>
	</body>
</html>
