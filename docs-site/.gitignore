# Installed by npm install.
node_modules/

# astro build output.
dist/
.astro/

# TWO pages are generated at build time from their canonical source:
#   handbook.md  ← ../docs/HANDBOOK.md
#   archive.md   ← the file list of docs/reviews, docs/research, docs/adr
# They are gitignored on purpose: a committed view is a second copy that can go
# stale without anyone noticing. Everything else under src/content/docs/ is the
# docs themselves and IS committed.
src/content/docs/handbook.md
src/content/docs/archive.md

# Lockfile is committed; these are not.
*.log
.DS_Store